datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model Lead {
  id         String   @id @default(uuid())
  parentName String
  email      String
  phone      String?
  childAge   String?
  message    String
  createdAt  DateTime @default(now())
}

model AdminUser {
  id       String @id @default("admin-id")
  username String @default("admin")
  password String @default("1234")
}

